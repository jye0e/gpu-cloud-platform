# ============================================
# 环境配置文件 - 请根据实际服务器环境修改
# ============================================

# 服务配置
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# JWT 密钥（生产环境务必更换为随机长字符串）
JWT_SECRET_KEY=your-super-secret-key-change-in-production-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/gpu_cloud.db

# 存储路径（模型文件存放根目录）
STORAGE_ROOT=/data/models

# Docker 配置
DOCKER_SOCKET=unix:///var/run/docker.sock
VLLM_IMAGE=vllm/vllm-openai:latest

# GPU 配置
GPU_MEMORY_RESERVE_MB=2048   # 为系统/DeepSeek自有业务预留的显存(MB)
MAX_TENANTS_PER_GPU=2         # 单块GPU最多支持的租户数

# 默认资源配额
DEFAULT_GPU_MEMORY_UTIL=0.4   # 默认租户vLLM显存利用率
DEFAULT_MAX_MODEL_LEN=4096    # 默认最大上下文长度
DEFAULT_STORAGE_QUOTA_GB=50   # 默认单租户存储配额(GB)
DEFAULT_QPS_LIMIT=10          # 默认单租户QPS限流

# 网关配置
GATEWAY_RATE_LIMIT=100        # 全局QPS上限
IDLE_TIMEOUT_MINUTES=30       # 闲置自动休眠时间(分钟)

# 日志
LOG_LEVEL=INFO
LOG_DIR=./logs
