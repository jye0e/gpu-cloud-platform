# ============================================
# GPU Cloud Platform 环境配置
# 复制此文件为 .env 并修改为实际环境配置
# ============================================

# --- 服务配置 ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# --- JWT 鉴权 ---
# ⚠️ 生产环境必须修改为强随机字符串！
JWT_SECRET_KEY=change-this-to-a-random-string-please
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# --- 数据库 ---
# 默认使用 SQLite，无需额外配置
# 生产环境可切换为 PostgreSQL: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./data/gpu_cloud.db

# --- 存储与日志 ---
STORAGE_ROOT=/data/models
LOG_DIR=./logs

# --- Docker 配置 ---
DOCKER_SOCKET=unix:///var/run/docker.sock
# 国内镜像源前缀（留空使用默认源）
# 示例: IMAGE_MIRROR_PREFIX=m.daocloud.io/docker.io/
IMAGE_MIRROR_PREFIX=

# --- 推理引擎镜像 ---
VLLM_IMAGE=vllm/vllm-openai:latest
TENSORRT_LLM_IMAGE=nvcr.io/nvidia/tensorrt-llm:latest
LM_DEPLOY_IMAGE=openmmlab/lmdeploy:latest
SGLANG_IMAGE=lmsysorg/sglang:latest
TGI_IMAGE=ghcr.io/huggingface/text-generation-inference:latest
OLLAMA_IMAGE=ollama/ollama:latest

# --- GPU 资源配置 ---
GPU_MEMORY_RESERVE_MB=2048       # 为系统自有业务预留的显存(MB)
MAX_TENANTS_PER_GPU=2             # 单块 GPU 最多支持的并发服务数

# --- 默认资源配额（新租户） ---
DEFAULT_GPU_MEMORY_UTIL=0.4       # 默认 vLLM 显存利用率
DEFAULT_MAX_MODEL_LEN=4096        # 默认最大上下文长度
DEFAULT_STORAGE_QUOTA_GB=50       # 默认单租户存储配额(GB)
DEFAULT_QPS_LIMIT=10              # 默认单租户 QPS 限流

# --- 网关与休眠 ---
GATEWAY_RATE_LIMIT=100            # 全局 QPS 上限
IDLE_TIMEOUT_MINUTES=30           # 闲置自动休眠时间(分钟)

# --- 日志 ---
LOG_LEVEL=INFO
